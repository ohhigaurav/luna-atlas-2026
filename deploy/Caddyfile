# HTTPS for the VM's Azure DNS name (LUNA_DOMAIN, e.g. luna-atlas-team.centralindia.cloudapp.azure.com).
# Caddy obtains and renews the Let's Encrypt certificate itself once ports 80 and 443 are open.
# Everything (the app at /, the API at /api) is the api container; it already gzips its responses.
{$LUNA_DOMAIN} {
	reverse_proxy api:8000
}
