# Copy to deploy/.env on the VM and fill in.
# The VM's DNS name from the Azure portal (VM -> Overview -> DNS name):
LUNA_DOMAIN=luna-atlas.centralindia.cloudapp.azure.com
# The hosted frontend's exact origin(s), comma-separated, no trailing slash:
LUNA_CORS_ORIGINS=https://luna-atlas.pages.dev
# Where people should land when they open the API's own address (the hosted app):
LUNA_FRONTEND_URL=https://luna-atlas.pages.dev
