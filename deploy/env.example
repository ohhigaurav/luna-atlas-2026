# Copy to deploy/.env on the VM and fill in.
# The VM's DNS name from the Azure portal (VM -> Overview -> DNS name):
LUNA_DOMAIN=luna-atlas-team.centralindia.cloudapp.azure.com
# Leave empty when the app is served from this VM (the default). Only if a copy of the app is also
# hosted elsewhere (e.g. Cloudflare Pages) and should call this API: its exact origin, no trailing slash.
LUNA_CORS_ORIGINS=
