# Do not commit downloaded kernels, DEM assets or generated run/cache artefacts.
data/kernels/*
!data/kernels/.gitkeep
!data/kernels/README.md
data/dems/assets/*
!data/dems/assets/.gitkeep
data/dems/quality/
data/dems/clones/
data/cache/*
!data/cache/horizons/
data/cache/horizons/*
!data/cache/horizons/.gitkeep
data/runs/*
!data/runs/.gitkeep
data/scans/*
data/ensembles/*
data/raw/
data/derived/
# Downloaded observation products used for validation (not committed).
data/reference/illumination/

# Static judge bundle (tools/bake_static.py); deployed from dist, not committed
frontend/app/public/data/*
# Moon weather forecast: ship the small files (mp4, lit bits, json), not frames.u8 (37 MB)
!frontend/app/public/data/shadow_movie/
frontend/app/public/data/shadow_movie/*
!frontend/app/public/data/shadow_movie/movie.mp4
!frontend/app/public/data/shadow_movie/lit.u8
!frontend/app/public/data/shadow_movie/movie.json
!frontend/app/public/data/shadow_movie/earth.u8
!frontend/app/public/data/shadow_movie/earth.json
!frontend/app/public/data/shadow_movie/earth_month.png

# LROC WAC movie frames (35 MB each; download with the commands in docs)
data/reference/lroc_movie/

# NASA Goddard PGDA 69 illumination maps (downloaded locally)
data/reference/pgda69/

# Local run logs (bootstrap, scans, verification output)
*.log
